# Copy this file to .env and fill in real values. .env is gitignored and
# is never read by anyone but your local process via python-dotenv.
#
# Use Binance TESTNET keys (https://testnet.binance.vision) here, not your
# real account keys. Real keys are only relevant once `mode: live` in
# config.yaml is a deliberate choice you make later.
#
# IMPORTANT: never fill in real values in THIS file (.env.example) - it is
# committed to git as a template. Put real values only in .env, which is
# gitignored and stays local to your machine.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional: a Slack/Discord-compatible incoming webhook URL (accepts a JSON
# POST with a "text" field). Unset by default - alerts (circuit breaker
# trips, significant feature drift, protective stop-loss triggers) are
# always journaled regardless; this only controls external notification.
ALERT_WEBHOOK_URL=

# Optional: email alerts via Gmail SMTP. SMTP_USERNAME is your full Gmail
# address; SMTP_PASSWORD must be a Gmail APP PASSWORD, not your real
# account password (create one at myaccount.google.com/apppasswords -
# requires 2-Step Verification to be enabled on the account). ALERT_EMAIL_TO
# accepts multiple comma-separated recipients. All three must be set for
# email delivery to activate; leave blank to journal-only, same as the
# webhook above. ALERT_EMAIL_MIN_SEVERITY (info/warning/critical, default
# critical) limits email specifically to the most serious alerts so routine
# warnings don't page a phone.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_MIN_SEVERITY=critical
