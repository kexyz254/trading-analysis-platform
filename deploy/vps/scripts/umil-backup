#!/usr/bin/env bash
set -euo pipefail

: "${UMIL_DATABASE_PATH:?UMIL_DATABASE_PATH is required}"
BACKUP_DIR=/var/backups/ats-umil
PYTHON=/opt/trading-analysis-platform/.venv-umil/bin/python
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
TARGET="$BACKUP_DIR/umil-$STAMP.db"

install -d -m 0750 "$BACKUP_DIR"
"$PYTHON" - "$UMIL_DATABASE_PATH" "$TARGET" <<'PY'
import sqlite3
import sys
source, target = sys.argv[1], sys.argv[2]
with sqlite3.connect(source) as src, sqlite3.connect(target) as dst:
    src.backup(dst, pages=256, sleep=0.01)
PY
find "$BACKUP_DIR" -type f -name 'umil-*.db' -mtime +14 -delete
