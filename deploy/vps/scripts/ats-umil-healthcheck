#!/usr/bin/env bash
set -u

check() {
    local unit="$1"
    local url="$2"
    if ! curl --fail --silent --show-error --max-time 12 "$url" >/dev/null; then
        logger -t ats-umil-healthcheck "$unit failed $url; restarting"
        systemctl restart "$unit"
        return 1
    fi
}

check umil.service http://127.0.0.1:8100/health/live || exit 1
check ats.service http://127.0.0.1:8000/pro || exit 1
