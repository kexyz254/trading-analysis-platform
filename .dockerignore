__pycache__/
*.pyc
*.pyo
.env
.venv
venv/
.vscode/
.idea/
*.log
*.log.*
.DS_Store

# Version control history has no business inside a build context or image
# layer - bloats the image and copies full commit history in for no
# runtime benefit.
.git/
.github/

# Real trading state: the docker-compose.yml bind mount overlays these at
# runtime regardless, but `docker compose build` would otherwise bake
# whatever real database/trade history exists on disk AT BUILD TIME
# permanently into an image layer - a real problem the moment that image
# is ever pushed to a registry, shared, or archived, not something a
# runtime bind mount retroactively fixes.
trading_system.db
trading_system.db-shm
trading_system.db-wal
backups/
archive/
run_system.lock

# Coverage/build artifacts - not needed at runtime, pure bloat.
# NOTE: tests/ is NOT excluded - the Dockerfile's own default CMD
# (`pytest tests`) and the CI docker-build workflow's smoke test both run
# the suite INSIDE the built image, so it must actually be present there.
.pytest_cache/
.coverage
htmlcov/

# Native fuzzing surface (C++) - irrelevant to the Python runtime image.
native/
fuzz/
out/

# Confidential production runtime state - never include in build context
umil_data/
dashboard_data/
logs/
runtime_logs/
.runtime/
archive/
ats-backups/
_umil_integration_stage/
trading_assistant/models/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.bak
*.joblib
*.zip
bankroll_trades_*.csv
.env.*
!.env.example
